     1	"""Step 2 of the data-as-pilot test (RULES2.md): replace the true anchor by the pilot-estimated one and resolve the
     2	before/after mirror with the pilot. Reuses calc.py (build, local_peaks, BUDGET, FRAMES, SNR, TAU, PAD, FMAX).
     3	No receiver or decoder calls.
     4	  python calc2.py --out out/result2.json     |     python calc2.py --smoke --out out/smoke2.json
     5	"""
     6	import argparse, json, sys
     7	from multiprocessing import get_context
     8	from pathlib import Path
     9	import numpy as np
    10	
    11	import calc
    12	from calc import BUDGET, FMAX, FRAMES, PAD, SNR, TAU, build, local_peaks, p1_driver, regressors, daft
    13	
    14	RHOS = (0.05, 0.10, 0.15, 0.20, 0.30)
    15	
    16	
    17	def column(z5, l, nu):
    18	    """Pilot-MF value at (delay l, nearest integer Doppler in [-2, 2]); -inf outside the delay range."""
    19	    if not 0 <= l < z5.shape[0]:
    20	        return -np.inf
    21	    return z5[l, int(np.clip(np.rint(nu), -2, 2)) + 2]
    22	
    23	
    24	def frame_eval(ctx, sf, scen, rho, frame, U, lmax):
    25	    raw, _ = p1_driver.generate(ctx, scen, rho, SNR, frame, sf)
    26	    s = ctx.system; p = raw['params']
    27	    l = np.asarray(p['l_i'], int); nu = np.asarray(p['k_real'], float); g = np.abs(np.asarray(p['g_i'])) ** 2
    28	    y = build(raw, s, p)
    29	    if not np.allclose(y, raw['y'], atol=1e-9):
    30	        raise AssertionError('y rebuild differs from the generator')
    31	    strongest = int(np.argmax(g))
    32	    weak = [w for w in range(len(l)) if w != strongest and g[w] >= TAU * float(raw['sigma2'])]
    33	    # Pilot MF over the F0 integer dictionary; anchor = its largest column.
    34	    z5 = (np.abs(U.conj().T @ y) ** 2).reshape(lmax + 1, 5)
    35	    c = int(np.argmax(z5)); la, ka = c // 5, c % 5 - 2
    36	    hit = np.where(l == la)[0]
    37	    a = int(hit[0]) if len(hit) else None
    38	    # Pilot-MF budget capture (same rule as calc.mf_arm) for the "missed by pilot" population.
    39	    mf = [m[1] for m in calc.mf_arm(y, U, None, l, nu, weak, lmax)]
    40	    rows = []
    41	    if a is None:
    42	        for k, w in enumerate(weak):
    43	            rows.append(dict(frame=frame, anchor_ok=False, rec=False, cap=False, mirror=None, mf=mf[k]))
    44	        return rows
    45	    # Autocorrelation map (same statistic as calc.ac_arm).
    46	    r = daft(y, s.c1, s.c2, inverse=True); n = len(r)
    47	    q = np.stack([r * np.conj(np.roll(r, d)) for d in range(1, lmax + 1)])
    48	    spec = np.fft.fft(q, n=PAD * n, axis=1); f = np.fft.fftfreq(PAD * n, d=1.0 / n)
    49	    keep = np.abs(f) <= FMAX; f, P = f[keep], np.abs(spec[:, keep]) ** 2
    50	
    51	    def cell(i, j):
    52	        d = l[i] - l[j]
    53	        return (d - 1, nu[i] - nu[j]) if d > 0 else (-d - 1, nu[j] - nu[i])
    54	
    55	    anchor_cells = np.zeros_like(P, dtype=bool)
    56	    for j in range(len(l)):
    57	        if j != a and l[j] != l[a]:
    58	            k, ff = cell(j, a)
    59	            anchor_cells[k, np.abs(f - ff) <= 1.0] = True
    60	    comp = P[local_peaks(P) & ~anchor_cells]
    61	    used = set()
    62	    for k_w, w in enumerate(weak):
    63	        if w == a or l[w] == l[a]:
    64	            rows.append(dict(frame=frame, anchor_ok=True, rec=w == a, cap=w == a, mirror=None, mf=mf[k_w])); continue
    65	        kk, ff = cell(w, a)
    66	        sel = np.where(np.abs(f - ff) <= 0.5)[0]
    67	        j = int(sel[np.argmax(P[kk, sel])]); pk = float(P[kk, j]); key = (kk, j // (2 * PAD))
    68	        cap = int(np.sum(comp >= pk)) < BUDGET and key not in used
    69	        used.add(key)
    70	        d, fo = kk + 1, float(f[j])          # observed folded lag and frequency of the peak
    71	        after = column(z5, la + d, ka + fo)  # candidate: w after the anchor
    72	        before = column(z5, la - d, ka - fo)  # mirror: w before the anchor
    73	        chosen = la + d if after >= before else la - d
    74	        mirror = bool(chosen == l[w])
    75	        rows.append(dict(frame=frame, anchor_ok=True, cap=bool(cap), mirror=mirror, rec=bool(cap and mirror), mf=mf[k_w]))
    76	    return rows
    77	
    78	
    79	_CTX = None
    80	
    81	
    82	def cell_rows(cell_key):
    83	    global _CTX
    84	    if _CTX is None:
    85	        ctx = p1_driver.load_context(); s = ctx.system; lmax = int(s.l_max_cap)
    86	        dl = np.repeat(np.arange(lmax + 1), 5); dk = np.tile(np.arange(-2, 3), lmax + 1)
    87	        U = regressors(np.asarray(s._zc_seq), dl, dk.astype(float), s.c1, s.c2)
    88	        _CTX = (ctx, p1_driver.make_seed_fn(), U / np.linalg.norm(U, axis=0, keepdims=True), lmax)
    89	    ctx, sf, U, lmax = _CTX
    90	    scen, rho = cell_key
    91	    out = []
    92	    for frame in FRAMES:
    93	        out += frame_eval(ctx, sf, scen, rho, frame, U, lmax)
    94	    return out
    95	
    96	
    97	def main():
    98	    ap = argparse.ArgumentParser()
    99	    ap.add_argument('--out', required=True)
   100	    ap.add_argument('--smoke', action='store_true')
   101	    a = ap.parse_args()
   102	    if a.smoke:
   103	        global FRAMES
   104	        calc.FRAMES = FRAMES = range(29990, 29994)
   105	        rows = cell_rows(('U', 0.15))
   106	        Path(a.out).write_text(json.dumps(dict(n=len(rows), keys=sorted(rows[0]) if rows else None)))
   107	        print('SMOKE', len(rows), sorted(rows[0]) if rows else None)
   108	        return
   109	    cells = [(s_, r_) for s_ in ('U', 'G') for r_ in RHOS]
   110	    with get_context('spawn').Pool(len(cells)) as pool:
   111	        res = dict(zip([f'{c[0]}/{c[1]}' for c in cells], pool.map(cell_rows, cells)))
   112	    summary = {}
   113	    for rho in RHOS:
   114	        rows = res[f'U/{rho}'] + res[f'G/{rho}']
   115	        frames = {}
   116	        for x in rows:
   117	            frames.setdefault(x['frame'], []).append(x)
   118	        miss = [x for x in rows if not x['mf']]
   119	        capd = [x for x in rows if x['cap'] and x['mirror'] is not None]
   120	        summary[str(rho)] = dict(
   121	            n_weak=len(rows), anchor_ok_frames=float(np.mean([v[0]['anchor_ok'] for v in frames.values()])),
   122	            cap=float(np.mean([x['cap'] for x in rows])), rec=float(np.mean([x['rec'] for x in rows])),
   123	            mirror_given_cap=float(np.mean([x['mirror'] for x in capd])) if capd else None,
   124	            mf=float(np.mean([x['mf'] for x in rows])), n_mf_miss=len(miss),
   125	            rec_given_mf_miss=float(np.mean([x['rec'] for x in miss])) if miss else None,
   126	            union=float(np.mean([x['rec'] or x['mf'] for x in rows])))
   127	    s15 = summary['0.15']
   128	    r4 = 'PASS' if s15['anchor_ok_frames'] >= .95 else 'FAIL' if s15['anchor_ok_frames'] < .85 else 'INCONCLUSIVE'
   129	    c = s15['rec_given_mf_miss']
   130	    r5 = 'PASS' if c >= .50 else 'FAIL' if c < .25 else 'INCONCLUSIVE'
   131	    out = dict(_argv=sys.argv, rules='RULES2.md', summary=summary, R4=r4, R5=r5)
   132	    Path(a.out).parent.mkdir(parents=True, exist_ok=True)
   133	    Path(a.out).write_text(json.dumps(out, indent=1))
   134	    print(json.dumps(out, indent=1))
   135	
   136	
   137	if __name__ == '__main__':
   138	    main()
     1	# 低导频"支撑已对、仍然失败"帧：零仿真读数（2026-11-20）
     2	
     3	规则在 [RULES.md](RULES.md)，计算前已提交（`17ff4f94`）。代码是 [readout.py](readout.py)，输出在 `out/readout_edit_budget.json`（主数据）和 `out/readout_rho_sweep.json`（复核数据）。
     4	只读已存的行，没有跑接收机。
     5	
     6	**SR 键**的定义：F0 失败触发了交换，CD4 的最终时延集合恰好等于 8 条真时延，也就是没有幻影、没有漏径。
     7	**干净区**的定义：数据 SNR ≥ 3.45 dB。在这个区域，ρ = .30 时给出真信道（A3）几乎从不失败。
     8	
     9	## 1. 观察
    10	| 判读 | 主数据（编辑预算，CD4） | 复核数据（ρ 扫描，CD） |
    11	|---|---|---|
    12	| R1 干净区 SR 失败率，ρ ≤ .20 | 69/1580 = 4.4% [3.5%, 5.5%] | 46/703 = 6.5% [4.9%, 8.6%] |
    13	| R2 ρ 每减半的失败优势比（同数据 SNR、同场景） | 3.07 [1.30, 11.0]（1819 键，78 个失败） | 6.18 [1.93, 34.9]（1011 键，49 个失败） |
    14	| R3 按功率加权的 Doppler 误差 e_w，同格 AUC | .816 [.733, .894] | .883 [.791, .961] |
    15	| R3 辅指标：最强径的 Doppler 误差，AUC | .713 [.605, .816] | .680 [.511, .834] |
    16	| e_w 中位数，失败 / 成功（Doppler 格） | .044 / .025 | .056 / .027 |
    17	| R4 ρ = .15 时的 SR 失败率，8 dB / 10 dB | 2/68，0/29 | 1/19，1/8 |
    18	| R5 ρ = .30、5 dB 的 SR 失败率 | 9/134 = 6.7% [3.6%, 12.3%] | 2/94 = 2.1% |
    19	
    20	分 SNR 看（主数据，SR 失败数 / SR 键数）：
    21	- ρ = .15，SNR 5.5–10 dB：15/569（2.6%），每个 SNR 点上都有失败；
    22	- ρ = .30，SNR ≥ 5.5 dB：0/105。注意 ρ = .30 这一侧的数据 SNR 反而更低。
    23	
    24	两组在这个高 SNR 段的直接比较（单侧 Fisher 检验，事后加的）：
    25	- 主数据 p = .077；
    26	- 复核数据 15/210 对 0/36，p = .086。
    27	
    28	**事后描述（未预注册）**：在同一个 SNR 下，只看**成功**的 SR 键，e_w 中位数也随 ρ 下降而上升。
    29	- 5–7 dB 时，ρ = .15 约为 .026–.030，ρ = .20 约为 .023–.028，ρ = .30 约为 .017–.021；
    30	- ρ 从 .30 降到 .15，误差约放大 1.3–1.5 倍；
    31	- 从 5 dB 到 7 dB，e_w 几乎不随 SNR 下降。
    32	
    33	## 2. 冻结判读
    34	- **R1：现象成立。** Wilson 下界 3.5% > 2%，复核数据同向。真信道在这个区域几乎不失败，所以单凭噪声（H_N）解释不了这批失败。
    35	- **R2：支持 H_C**（导频能量限制了支撑已对时的参数估计）。下界 1.30 > 1，复核数据同向。
    36	  - 触发选择造成的偏差方向是把 OR 往 < 1 推，所以这个方向的结论是稳的。
    37	  - 但 OR 值本身依赖 logistic 模型在数据 SNR 上取线性；不依赖模型的高 SNR 段比较单看只到 p ≈ .08。
    38	- **R3：Doppler 误差承载失败**（H_D）。AUC .816 ≥ .70，下界 .733 > .60，复核数据同向。
    39	- R4：样本太少，看不出有没有地板。
    40	- R5：比 GS-set 的 ~15% 低，方向符合预期。SR 是 CD4 自己找全时延的帧，比"给出真时延的全部 F0 失败帧"更容易。没有再查。
    41	
    42	## 3. 候选解释（未检验）
    43	- **E1（M）**：低导频下，正确时延上的分数 Doppler 估计更不准，残余 Doppler 失配让部分帧越过译码门限。
    44	  - 支持的证据有三条：e_w 区分失败帧（R3）；成功帧的 e_w 也随 ρ 降低而增大（约 1.3–1.5 倍，接近导频幅度比 √2）；失败率随导频减半而上升（R2）。三条互相一致。
    45	  - e_w 几乎不随 SNR 下降，像是受干扰限制而不是受噪声限制。叠加导频下，数据对导频估计的干扰不随 SNR 消失，这符合这种情形。但这一点只有事后描述支持。
    46	- **不能排除的情形**：e_w 只是症状。比如近邻径或弱径让 Doppler 和增益同时估偏，真正导致失败的是增益误差（H_C 的另一半，行里没存估计增益）或检测器（H_X）。
    47	- **最便宜的证伪检验**（需要另写冻结协议，并经 Eric 批准）：在这批 SR 失败帧上重放一次，只把正确时延上的 Doppler 换成真值，保持增益估计的流程不变。
    48	  - 如果大部分帧被救回，E1 成立；
    49	  - 如果救回很少，失败在增益或检测器。
    50	  - 规模：ρ ≤ .20 干净区的 69 + 46 帧，加同格的成功帧作对照，远少于 1 核时。
    51	
    52	## 4. 范围与停止条件
    53	- 这批帧在实际工作点 ρ = .30 的 SNR ≥ 5.5 dB 处不存在（0/105），只在 ρ ≤ .20 出现。所以上一条线的停止条件 3（改进只出现在不用的工作点）同样适用。
    54	- 规模上：在 ρ = .15、6–8 dB，SR 失败占 CD4 失败的 11/85（[第一步读数](../../.trellis/tasks/archive/2026-11/11-20-low-pilot-missed-path/research/step1-readout-20261120.md) R1）。低导频下失败的主体仍是漏径。
    55	- 和论文的关系（只登记，不改论文任务）：支撑已对时，失败来自参数精度而不是支撑。这类帧正是"继续迭代（用译码后的数据重估参数）比重搜更合适"的情形。但这一点目前只是推论，没有测过。
    56	
    57	## 5. 预测记分
    58	| 判读 | 预测 | 结果 | 多类 Brier |
    59	|---|---|---|---|
    60	| R1 | 成立 .70 / 不确定 .20 / H_N .10 | 成立 | 0.140 |
    61	| R2 | 支持 H_C .35 / 不确定 .45 / 无证据 .20 | 支持 H_C | 0.665 |
    62	| R3 | 承载 .25 / 不确定 .45 / 不承载 .30 | 承载 | 0.855 |
    63	
    64	R2 和 R3 我都低估了：我原先以为，时延对了以后剩下的主要是噪声。

