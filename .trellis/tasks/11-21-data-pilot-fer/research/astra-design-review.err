    95	                            '        counts["joint_gain_solves"] += 1\n'
    96	                            '        _check_pass(pass_start, value, pass_end)\n'
    97	                            + final + '    _start_pass(current)\n')
    98	    # The across-pass objectives differ. The original coordinate guards stay,
    99	    # and pass endpoints are checked anew under their own fixed objective.
