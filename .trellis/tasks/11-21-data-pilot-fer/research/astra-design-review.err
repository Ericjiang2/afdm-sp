   104	class _SpectralGeometry:
   105	    def __init__(self, cd, tau, total, n, check_scores, arm, response_cache=None):
   106	        self.cd = cd
   107	        self.tau = tau
   108	        self.total = total
   109	        self.n = n
   110	        self.check_scores = check_scores
   111	        self.arm = arm
   112	        self.response_cache = {} if response_cache is None else response_cache
   113	        self.fixed = None
   114	        self.census = _empty_census()
   115	        self.census.update(passes_checked=0, max_pass_increase=0.)
   116	        base_system = cd._system
   117	        self.base_variance = base_system.__globals__['projected_variance']
   118	        self.system = FunctionType(base_system.__code__,
   119	                                   dict(base_system.__globals__, projected_variance=self.variance),
   120	                                   base_system.__name__, base_system.__defaults__)
   121	
   122	    def start_pass(self, current):
   123	        self.fixed = low_projector([p.delay for p in current], [p.doppler for p in current],
   124	                                   self.n, self.tau)
   125	
   126	    def check_pass(self, start, recorded, refit):
   127	        self.census['passes_checked'] += 1
   128	        self.census['max_pass_increase'] = max(self.census['max_pass_increase'], refit - start)
   129	        if refit > start or not np.isclose(refit, recorded, rtol=1e-12, atol=1e-12):
   130	            raise AssertionError(f'{self.arm} fixed-projector pass objective: {start}, {recorded}, {refit}')
   131	
   132	    def variance(self, v, delays, dopplers, c1):
   133	        gamma = self.base_variance(v, delays, dopplers, c1)
   134	        p = self.fixed if self.fixed is not None else low_projector(delays, dopplers, self.n, self.tau)
   135	        return _replace_spectrum(gamma, p, self.total, self.arm)
   136	
   137	    def direct_scores(self, Y, xt, v, current, B, Q, b, c1, c2, ridge,
   138	                      delays, dopplers, chunk_size, energy, tolerance, counts, gamma_mode):
