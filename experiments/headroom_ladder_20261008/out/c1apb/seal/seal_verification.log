{"_argv": ["/home/guoyikun/.conda/envs/AFDM/bin/python", "-B", "-c", "import c1apb_lib as L,json,numpy as np,math\nfrom pathlib import Path\nd=json.loads(Path(\"out/c1apb/seal/seal.json\").read_text())\nmodel=d[\"models\"][\"pooled\"][\"full\"]\nbeta=np.asarray(model[\"coef\"])/np.asarray(model[\"sd\"])\nbase=model[\"intercept\"]-np.dot(beta,np.asarray(model[\"mean\"]))\nfor cell in (\"C2\",\"C3\"):\n    z=d[\"cells\"][cell]\n    k=8*L.CELLS[cell][1]/L.N\n    sigma=10**(-L.CELLS[cell][0]/1000)/(2*.7)\n    for Rc in sorted({p[\"Rc\"] for p in z[\"choices\"][\"P\"][\"policies\"]}):\n        values=[]\n        for r in range(1,min(3,Rc-1)+1):\n            offset=beta[5]*(10-r)/10-(beta[9]+beta[10]*k)*(Rc-r)/20\n            bounds=[]\n            for e in (10,r):\n                b=(20*max(0,min(e,Rc)-r)+40*max(0,Rc-max(e,r)))/400\n                delta=math.log(1027)-math.log(2) if r>1 else 0\n                low=np.array([math.log(2),0,r,-delta,Rc/10,e/10,0,k,math.log(sigma),b,k*b])\n                high=np.array([math.log(1027),50,r,delta,Rc/10,e/10,0,k,math.log(sigma),b,k*b])\n                lo=base+np.where(beta>=0,beta*low,beta*high).sum()\n                hi=base+np.where(beta>=0,beta*high,beta*low).sum()\n                bounds.append((float(lo),float(hi)))\n            values.append(dict(r=r,eta20_minus_etae=float(offset),eta_bounds=bounds))\n        print(cell,Rc,values)\nprint(\"all_sealed_kappas\",{c:[p[\"k\"] for p in z[\"choices\"][\"P\"][\"policies\"]] for c,z in d[\"cells\"].items() if z[\"choices\"][\"P\"]})\nprint(\"source_and_inputs_unchanged\")\nL.assert_unchanged(dict(d[\"input_md5s\"],**d[\"code_md5s\"]))\nprint(\"HASH_PASS\")\npairs,_,_=L.load_cells([L.HERE/\"out/c1apb_cal\"],tuple(L.CELLS),range(600),L.NEW,L.MCHECKS,shuffled=True,shards=64)\nfor cell,(o,y) in pairs.items():\n    z=d[\"cells\"][cell]\n    cache=L.qcache(o,model,d[\"models\"][\"pooled\"][\"rescue\"])\n    outputs={}\n    for name in (\"P\",\"Bstar\"):\n        mix=z[\"choices\"][name]\n        if mix is not None:\n            a=L.eval_mix(o,y,mix,cache,d[\"overhead_seconds\"])\n            expected=z[\"actual_cal\"][name]\n            assert math.isclose(a[\"fail\"].mean(),expected[\"fer\"],abs_tol=1e-14)\n            assert math.isclose(a[\"cost\"].mean(),expected[\"cost\"],abs_tol=1e-14)\n            outputs[name]=a\n    if z[\"operable\"]:\n        assert L.plan_n(outputs[\"P\"][\"fail\"],outputs[\"Bstar\"][\"fail\"])==z[\"planning\"]\n        print(\"SELECTED_REPLAY_PASS\",cell,dict(R=float(outputs[\"P\"][\"cost\"].mean()/outputs[\"Bstar\"][\"cost\"].mean()),identical_fail=bool(np.array_equal(outputs[\"P\"][\"fail\"],outputs[\"Bstar\"][\"fail\"])),identical_path=bool(np.array_equal(outputs[\"P\"][\"arm\"],outputs[\"Bstar\"][\"arm\"]) and np.array_equal(outputs[\"P\"][\"stop\"],outputs[\"Bstar\"][\"stop\"]))))\nprint(\"VERIFICATION_PASS\")\n"], "_config": {"kind": "POST_SEAL_VERIFICATION", "selection_refit": false, "no_TEST": true, "logit_box": "syn live1..1026, dec0..50, r1..3; loose independent observable bounds"}, "input_md5s": {"out/c1apb/seal/seal.json": "466a92d0fa371e7871c97c475ff0a906"}, "code_md5s": {"/data/guoyikun/00inbox/AFDM-channel-estimation/experiments/headroom_ladder_20261008/c1apb_lib.py": "fcf122277f8b08a612339efcc6b5f5da", "/data/guoyikun/00inbox/AFDM-channel-estimation/experiments/headroom_ladder_20261008/c1apb_stage1.py": "5e344c405d9e29b6bb8d2d8f12b0096f", "/data/guoyikun/00inbox/AFDM-channel-estimation/experiments/headroom_ladder_20261008/c1apb_stage2.py": "edbbe5f9cc80578a993347408361aa61", "/data/guoyikun/00inbox/AFDM-channel-estimation/experiments/headroom_ladder_20261008/unit_check_c1apb.py": "6a664cce3c21be99260c89331d95709a"}, "analysis_environment": {"python": "3.10.20 (main, Mar 11 2026, 17:46:40) [GCC 14.3.0]", "numpy": "1.26.4", "hostname": "liunxgpu", "thread_environment": {"OPENBLAS_NUM_THREADS": "1", "OMP_NUM_THREADS": "1", "MKL_NUM_THREADS": "1"}}}
