\@writefile{toc}{\contentsline {paragraph}{Analysis (a) --- OMP-once recall against the Dirichlet virtual-tap oracle support.}{24}{section*.32}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces 4\,B BER waterfall under the paired-frame protocol, pooled across three independent evaluation-seed blocks (seeds $20\,260\,423$/$424$/$425$; adaptive frame counts 600/773/1\,300 at $\mathrm  {SNR}= 20/25/30$~dB, driven by the error-budget early-stop rule of \S  \ref {ssec:eval}). Column $\Delta $ is the relative paired-BER change of learned head{} against \textsc  {Classical joint}{}, with McNemar $p$-values where both arms are above the finite-sample floor. CP = Clopper--Pearson $95\%$ confidence interval. \emph  {Provenance note.} The pooled relative reductions $-37.74/-40.15/-37.59\%$ at $\mathrm  {SNR}= 20/25/30$~dB (rounded to $-37.7/-40.2/-37.6\%$ in the table for compactness) reproduce exactly from the paired McNemar $n_{10}/n_{01}$ counts of three committed seed-block runs (\texttt  {outputs\_loop12\_r3\_official}, \texttt  {outputs\_loop12\_seed2\_s20\_s25\_s30}, \texttt  {outputs\_loop12\_matched\_f2p\_s20\_30}) via the auditor-friendly committed aggregation script \texttt  {afdm\_sp\_joint\_unrolled/scripts/aggregate\_pooled\_pairedeval.py}; canonical output is committed as \texttt  {scripts/pooled\_paired\_eval\_4B\_table\_ber4b.md}. The absolute BER columns are derived from the same operating point ($N= 1024$, $P= 8$, $f_s= 4B$, ZC pilot $r=7$, $\rho = 0.5$); a single committed JSON containing the absolute pooled 4B-BERs at all five SNRs is one of the deferred artefacts noted in \S  \ref {ssec:weaknesses} (last item).}}{25}{table.caption.29}\protected@file@percent }
\newlabel{tab:ber4b}{{3}{25}{4\,B BER waterfall under the paired-frame protocol, pooled across three independent evaluation-seed blocks (seeds $20\,260\,423$/$424$/$425$; adaptive frame counts 600/773/1\,300 at $\snr = 20/25/30$~dB, driven by the error-budget early-stop rule of \S \ref {ssec:eval}). Column $\Delta $ is the relative paired-BER change of \LearnedHead {} against \ClassicalJoint {}, with McNemar $p$-values where both arms are above the finite-sample floor. CP = Clopper--Pearson $95\%$ confidence interval. \emph {Provenance note.} The pooled relative reductions $-37.74/-40.15/-37.59\%$ at $\snr = 20/25/30$~dB (rounded to $-37.7/-40.2/-37.6\%$ in the table for compactness) reproduce exactly from the paired McNemar $n_{10}/n_{01}$ counts of three committed seed-block runs (\texttt {outputs\_loop12\_r3\_official}, \texttt {outputs\_loop12\_seed2\_s20\_s25\_s30}, \texttt {outputs\_loop12\_matched\_f2p\_s20\_30}) via the auditor-friendly committed aggregation script \texttt {afdm\_sp\_joint\_unrolled/scripts/aggregate\_pooled\_pairedeval.py}; canonical output is committed as \texttt {scripts/pooled\_paired\_eval\_4B\_table\_ber4b.md}. The absolute BER columns are derived from the same operating point ($\Nsub = 1024$, $\Ppath = 8$, $\fs = 4B$, ZC pilot $r=7$, $\rhop = 0.5$); a single committed JSON containing the absolute pooled 4B-BERs at all five SNRs is one of the deferred artefacts noted in \S \ref {ssec:weaknesses} (last item)}{table.caption.29}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Per-iteration BER at $f_s= 4B$: 80~frames per $(t, \mathrm  {SNR}\!=\!15\,\text  {dB})$ cell and 300 frames per $(t, \mathrm  {SNR}\!=\!20\,\text  {dB})$ cell. The retrained learned-head checkpoint is deployed at inference under the standard ranking-only configuration of \S  \ref {ssec:c2rel}.}}{25}{table.caption.31}\protected@file@percent }
\newlabel{tab:iterconv}{{4}{25}{Per-iteration BER at $\fs = 4B$: 80~frames per $(t, \snr \!=\!15\,\text {dB})$ cell and 300 frames per $(t, \snr \!=\!20\,\text {dB})$ cell. The retrained learned-head checkpoint is deployed at inference under the standard ranking-only configuration of \S \ref {ssec:c2rel}}{table.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Outer-iteration convergence at $\mathrm  {SNR}\in \{15, 20\}$~dB, $f_s= 4B$, with 80 paired frames per $(t, \mathrm  {SNR}\!=\!15\,\text  {dB})$ cell and 300 paired frames per $(t, \mathrm  {SNR}\!=\!20\,\text  {dB})$ cell. Both recipes descend rapidly over $t = 1, \dots  , 4$ and saturate by $t = 4$. The classical $t = 4 \!\to \! 5$ move at $\mathrm  {SNR}= 20$~dB ($8.81 \times 10^{-4} \!\to \! 9.07 \times 10^{-4}$, $+3\%$) sits within $1\sigma $ of a $614{,}400$-bit binomial count; the learned $t = 4 \!\to \! 5$ move ($4.51 \times 10^{-4} \!\to \! 5.42 \times 10^{-4}$, $+20\%$, $\approx 3\sigma $) is consistent with a residual saturation--counting-noise interaction rather than an iteration blow-up. Numerical values in Table~\ref {tab:iterconv}.}}{26}{figure.caption.30}\protected@file@percent }
\newlabel{fig:iterconv}{{6}{26}{Outer-iteration convergence at $\snr \in \{15, 20\}$~dB, $\fs = 4B$, with 80 paired frames per $(t, \snr \!=\!15\,\text {dB})$ cell and 300 paired frames per $(t, \snr \!=\!20\,\text {dB})$ cell. Both recipes descend rapidly over $t = 1, \dots , 4$ and saturate by $t = 4$. The classical $t = 4 \!\to \! 5$ move at $\snr = 20$~dB ($8.81 \times 10^{-4} \!\to \! 9.07 \times 10^{-4}$, $+3\%$) sits within $1\sigma $ of a $614{,}400$-bit binomial count; the learned $t = 4 \!\to \! 5$ move ($4.51 \times 10^{-4} \!\to \! 5.42 \times 10^{-4}$, $+20\%$, $\approx 3\sigma $) is consistent with a residual saturation--counting-noise interaction rather than an iteration blow-up. Numerical values in Table~\ref {tab:iterconv}}{figure.caption.30}{}}
\@writefile{toc}{\contentsline {paragraph}{Analysis (b) --- Top-$P$ physical-support-oracle headroom.}{26}{section*.35}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces OMP-once recall against the effective Dirichlet-expanded virtual-tap oracle support (mean effective size $p_{\text  {real}} \approx 28$ per frame; the OMP support itself has size $P= 8$), computed from the $4B$ feature cache. ``Frac.~frames~$\geq 1$~missed'' is the fraction of frames on which the learned head has at least one Dirichlet-leakage virtual tap to repair.}}{27}{table.caption.33}\protected@file@percent }
\newlabel{tab:supportrecall}{{5}{27}{OMP-once recall against the effective Dirichlet-expanded virtual-tap oracle support (mean effective size $p_{\text {real}} \approx 28$ per frame; the OMP support itself has size $\Ppath = 8$), computed from the $4B$ feature cache. ``Frac.~frames~$\geq 1$~missed'' is the fraction of frames on which the learned head has at least one Dirichlet-leakage virtual tap to repair}{table.caption.33}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Left: mean OMP-once recall against the effective Dirichlet-expanded virtual-tap oracle support (mean effective size $\approx 28$; definition in Appendix~\ref {app:recall}), as a function of SNR. Recall is stable at $\approx 95\%$, indicating that the support-selection residual is structural rather than noise-driven. Right: fraction of frames on which OMP misses at least one virtual-tap oracle atom. Prevalence is $\approx 67$--$71\%$ and essentially flat across SNR. Axes: SNR in dB; left panel $y =$ mean recall in $[0, 1]$; right panel $y =$ fraction of frames with $\geq 1$ missed atom. Error bars are $1\sigma $ across frames within each SNR cell.}}{27}{figure.caption.34}\protected@file@percent }
\newlabel{fig:recall}{{7}{27}{Left: mean OMP-once recall against the effective Dirichlet-expanded virtual-tap oracle support (mean effective size $\approx 28$; definition in Appendix~\ref {app:recall}), as a function of SNR. Recall is stable at $\approx 95\%$, indicating that the support-selection residual is structural rather than noise-driven. Right: fraction of frames on which OMP misses at least one virtual-tap oracle atom. Prevalence is $\approx 67$--$71\%$ and essentially flat across SNR. Axes: SNR in dB; left panel $y =$ mean recall in $[0, 1]$; right panel $y =$ fraction of frames with $\geq 1$ missed atom. Error bars are $1\sigma $ across frames within each SNR cell}{figure.caption.34}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Top-$P$ physical-support-oracle diagnostic at $f_s= 4B$, 250 paired frames per cell (baseline and oracle share the same frames). The physical oracle picks dictionary atoms corresponding directly to the simulator's $(l_p, \lfloor k_p^\text  {real}\rceil )$ main-lobe indices ranked by $|g_i|$, and provides a valid ceiling on what any top-$P$ support-refinement method can achieve. Gap closed $= (\text  {baseline} - \text  {learned}) / (\text  {baseline} - \text  {oracle}_\text  {physical})$. The physical oracle's zeros at $\mathrm  {SNR}\in \{20, 25\}$~dB are censored observations: $0$ errors in $5.12 \times 10^{5}$ paired bits, Clopper--Pearson $95\%$ upper bound $\approx 5.86 \times 10^{-6}$.}}{28}{table.caption.36}\protected@file@percent }
\newlabel{tab:oraclehead}{{6}{28}{Top-$\Ppath $ physical-support-oracle diagnostic at $\fs = 4B$, 250 paired frames per cell (baseline and oracle share the same frames). The physical oracle picks dictionary atoms corresponding directly to the simulator's $(l_p, \lfloor k_p^\text {real}\rceil )$ main-lobe indices ranked by $|g_i|$, and provides a valid ceiling on what any top-$\Ppath $ support-refinement method can achieve. Gap closed $= (\text {baseline} - \text {learned}) / (\text {baseline} - \text {oracle}_\text {physical})$. The physical oracle's zeros at $\snr \in \{20, 25\}$~dB are censored observations: $0$ errors in $5.12 \times 10^{5}$ paired bits, Clopper--Pearson $95\%$ upper bound $\approx 5.86 \times 10^{-6}$}{table.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Top-$P$ physical-support-oracle headroom at $\mathrm  {SNR}\in \{15, 20, 25\}$~dB, $f_s= 4B$ (log-BER on $x$-axis; four bars per SNR cell: Classical, Oracle physical, Learned, PCSI+MMSE). The physical oracle replaces OMP's selected support with the simulator's ground-truth top-$P$ atoms, providing a valid ceiling on what any top-$P$ support-refinement method can achieve. The Learned bar is annotated with the fraction of the baseline-to-physical-oracle gap closed by the learned head: $61\%/81\%/98\%$ at $\mathrm  {SNR}= 15/20/25$~dB. The physical oracle's near-zero values at $\mathrm  {SNR}\in \{20, 25\}$~dB are censored observations: $0$ errors in $5.12 \times 10^{5}$ paired bits, plotted at $5\times 10^{-7}$ for visibility (Clopper--Pearson $95\%$ upper bound $\approx 5.86 \times 10^{-6}$).}}{28}{figure.caption.37}\protected@file@percent }
\newlabel{fig:oraclehead}{{8}{28}{Top-$\Ppath $ physical-support-oracle headroom at $\snr \in \{15, 20, 25\}$~dB, $\fs = 4B$ (log-BER on $x$-axis; four bars per SNR cell: Classical, Oracle physical, Learned, PCSI+MMSE). The physical oracle replaces OMP's selected support with the simulator's ground-truth top-$\Ppath $ atoms, providing a valid ceiling on what any top-$\Ppath $ support-refinement method can achieve. The Learned bar is annotated with the fraction of the baseline-to-physical-oracle gap closed by the learned head: $61\%/81\%/98\%$ at $\snr = 15/20/25$~dB. The physical oracle's near-zero values at $\snr \in \{20, 25\}$~dB are censored observations: $0$ errors in $5.12 \times 10^{5}$ paired bits, plotted at $5\times 10^{-7}$ for visibility (Clopper--Pearson $95\%$ upper bound $\approx 5.86 \times 10^{-6}$)}{figure.caption.37}{}}
