\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Main 4\,B BER waterfall (left) and channel-estimation NMSE (right) at $f_s= 4B$ for the four receivers described in \S  \ref {ssec:fairness}. The learned head{} line is produced by the 27\,k-frame 4-SNR retrained checkpoint. The \textsc  {OMP+MP serial}{} arm saturates from $\mathrm  {SNR}\geq 15$~dB; the \textsc  {Classical joint}{} and learned head{} arms continue to descend, with learned head{} consistently below \textsc  {Classical joint}{} in the high-SNR region. The \textsc  {PCSI+MMSE}{} curve is a PCSI+MMSE reference, not an information-theoretic lower bound.}}{24}{figure.caption.28}\protected@file@percent }
\newlabel{fig:ber4b}{{5}{24}{Main 4\,B BER waterfall (left) and channel-estimation NMSE (right) at $\fs = 4B$ for the four receivers described in \S \ref {ssec:fairness}. The \LearnedHead {} line is produced by the 27\,k-frame 4-SNR retrained checkpoint. The \Serial {} arm saturates from $\snr \geq 15$~dB; the \ClassicalJoint {} and \LearnedHead {} arms continue to descend, with \LearnedHead {} consistently below \ClassicalJoint {} in the high-SNR region. The \Oracle {} curve is a PCSI+MMSE reference, not an information-theoretic lower bound}{figure.caption.28}{}}
