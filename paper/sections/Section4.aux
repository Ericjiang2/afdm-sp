\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Single-frame OMP support and learned-head additions on a representative frame at $\mathrm  {SNR}= 20$~dB, drawn from a $300$-seed online replay at the paper-canonical operating point ($P= 8$, top-$M = 96$, $K_{\mathrm  {add}}= 4$, $f_s= 4B$, $N= 1024$) and selected by the disclosed deterministic rule \emph  {(above-median oracle-missed count, top-$K_{\mathrm  {add}}$ head additions overlap with at least one oracle-missed atom, per-frame BER closest to the cache median)}. Gray dots: the $M = 96$ candidate pool surfaced to the ranker; blue circles: the OMP-once support of size $|\hat  {S}_\text  {OMP}| = P= 8$; red stars: Dirichlet-expanded oracle-missed atoms; green crosses: the top-$K_{\mathrm  {add}}= 4$ atoms promoted by the learned head. Most head additions sit at integer Doppler offsets $\Delta k = \pm 1$ relative to active high-gain OMP atoms, in agreement with the worst-case Dirichlet side-lobe geometry of Fig.~\ref {fig:dirichlet}. The frame is provided as a representative attribution example and is not a substitute for the population-level support-recall and oracle-headroom analyses of \S  \ref {ssec:probes}.}}{33}{figure.caption.40}\protected@file@percent }
\newlabel{fig:singleframe}{{9}{33}{Single-frame OMP support and learned-head additions on a representative frame at $\snr = 20$~dB, drawn from a $300$-seed online replay at the paper-canonical operating point ($\Ppath = 8$, top-$M = 96$, $\Kadd = 4$, $\fs = 4B$, $\Nsub = 1024$) and selected by the disclosed deterministic rule \emph {(above-median oracle-missed count, top-$\Kadd $ head additions overlap with at least one oracle-missed atom, per-frame BER closest to the cache median)}. Gray dots: the $M = 96$ candidate pool surfaced to the ranker; blue circles: the OMP-once support of size $|\hat {S}_\text {OMP}| = \Ppath = 8$; red stars: Dirichlet-expanded oracle-missed atoms; green crosses: the top-$\Kadd = 4$ atoms promoted by the learned head. Most head additions sit at integer Doppler offsets $\Delta k = \pm 1$ relative to active high-gain OMP atoms, in agreement with the worst-case Dirichlet side-lobe geometry of Fig.~\ref {fig:dirichlet}. The frame is provided as a representative attribution example and is not a substitute for the population-level support-recall and oracle-headroom analyses of \S \ref {ssec:probes}}{figure.caption.40}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Population-level per-candidate attribution: classification of every head-added atom across a $250$-frame paired evaluation run at the canonical operating point ($N= 1024$, $P= 8$, $f_s= 4B$, $K_{\mathrm  {add}}= 4$ effective $K_\text  {add,used} = 2$ on average per refine pass), against the simulator's known $(l_p, k_p)$ physical paths. ``Side+Virt\%'' is the fraction of head additions falling on a Dirichlet side-lobe or virtual tap of an active physical path; the complementary $1 -$``Side+Virt\%'' is split between main-lobe collisions and false positives.}}{34}{table.caption.41}\protected@file@percent }
\newlabel{tab:attribution}{{9}{34}{Population-level per-candidate attribution: classification of every head-added atom across a $250$-frame paired evaluation run at the canonical operating point ($\Nsub = 1024$, $\Ppath = 8$, $\fs = 4B$, $\Kadd = 4$ effective $K_\text {add,used} = 2$ on average per refine pass), against the simulator's known $(l_p, k_p)$ physical paths. ``Side+Virt\%'' is the fraction of head additions falling on a Dirichlet side-lobe or virtual tap of an active physical path; the complementary $1 -$``Side+Virt\%'' is split between main-lobe collisions and false positives}{table.caption.41}{}}
