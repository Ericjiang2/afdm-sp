\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces OMP dictionary size under the canonical AFDM configuration used throughout this report ($\tau _{\text  {spread}} = 10$~ms, $v_{\max } = 3$~m/s, $f_c= 12$~kHz, $f_s= 4B = 16$~kHz). Under the fixed-$f_s$ convention, $l_{\max }= \lceil \tau _{\text  {spread}} f_s\rceil = 160$ is independent of $N$, while $k_{\max }= \lceil v_{\max }f_cN/(cf_s)\rceil $ grows linearly with $N$. The Chapter~\ref {sec:results} operating point ($N= 1024$) corresponds to the middle row.}}{12}{table.caption.17}\protected@file@percent }
\newlabel{tab:dictsize}{{1}{12}{OMP dictionary size under the canonical AFDM configuration used throughout this report ($\tau _{\text {spread}} = 10$~ms, $v_{\max } = 3$~m/s, $\fc = 12$~kHz, $\fs = 4B = 16$~kHz). Under the fixed-$\fs $ convention, $\lmax = \lceil \tau _{\text {spread}} \fs \rceil = 160$ is independent of $\Nsub $, while $\kmax = \lceil v_{\max }\fc \Nsub /(c\fs )\rceil $ grows linearly with $\Nsub $. The Chapter~\ref {sec:results} operating point ($\Nsub = 1024$) corresponds to the middle row}{table.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Classical OMP-once + iterative LS/MP-BP joint receiver (Algorithm~\ref {alg:joint} in block-diagram form). The outer loop (dashed rectangle) runs for $T_\text  {out} = 5$ iterations; each iteration forms a data-cancellation residual, refits the path gains on a locked support via damped DA-LS, runs sparse MP-BP detection on the Dirichlet-expanded virtual-tap factor graph, updates the adaptive noise-variance estimate, and prunes the support.}}{12}{figure.caption.18}\protected@file@percent }
\newlabel{fig:classical_joint_arch}{{2}{12}{Classical OMP-once + iterative LS/MP-BP joint receiver (Algorithm~\ref {alg:joint} in block-diagram form). The outer loop (dashed rectangle) runs for $T_\text {out} = 5$ iterations; each iteration forms a data-cancellation residual, refits the path gains on a locked support via damped DA-LS, runs sparse MP-BP detection on the Dirichlet-expanded virtual-tap factor graph, updates the adaptive noise-variance estimate, and prunes the support}{figure.caption.18}{}}
