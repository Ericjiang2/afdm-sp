\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Integration of the learned support-refinement head into the classical OMP-once + iterative LS/MP-BP receiver. The learned block (dark blue) is invoked twice at the initialisation step ($t = 0$), immediately after OMP-once and before the iterative LS/MP-BP loop begins; it ranks the top-$M = 96$ off-support candidates and appends the top-$K_{\mathrm  {add}}$ atoms to the support. All other blocks are identical to Fig.~\ref {fig:classical_joint_arch}: the head replaces neither OMP-once nor the iterative LS/MP-BP block. The detailed head architecture is given in Fig.~\ref {fig:head_arch}.}}{16}{figure.caption.20}\protected@file@percent }
\newlabel{fig:pipeline_integration}{{3}{16}{Integration of the learned support-refinement head into the classical OMP-once + iterative LS/MP-BP receiver. The learned block (dark blue) is invoked twice at the initialisation step ($t = 0$), immediately after OMP-once and before the iterative LS/MP-BP loop begins; it ranks the top-$M = 96$ off-support candidates and appends the top-$\Kadd $ atoms to the support. All other blocks are identical to Fig.~\ref {fig:classical_joint_arch}: the head replaces neither OMP-once nor the iterative LS/MP-BP block. The detailed head architecture is given in Fig.~\ref {fig:head_arch}}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {paragraph}{Feature design rationale.}{16}{section*.23}\protected@file@percent }
\citation{elfwing2018silu}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Learned support-refinement head (architecture). Two parallel inputs per candidate $i$: a 7-D self-feature $\mathbf  {u}_i$ and a set of 6-D pair features $\{\mathbf  {v}_{i,s}\}_{s \in \hat  {S}}$ indexed over the current active support $\hat  {S}$. The shared pair-encoder ($\mathbb  {R}^6 \!\to \! \mathbb  {R}^{16} \!\to \! \mathbb  {R}^{16}$, 384 parameters) is applied element-wise over $(i, s)$ pairs; order-invariant pooling (concat of channel-wise max and mean over $s \in \hat  {S}$) produces a 32-D pair descriptor per candidate, which is concatenated with $\mathbf  {u}_i$ to form $\boldsymbol  {\phi }_i \in \mathbb  {R}^{39}$. The shared scorer ($\mathbb  {R}^{39} \!\to \! \mathbb  {R}^{16} \!\to \! \mathbb  {R}^1$, 657 parameters) emits a scalar logit $s_i$; the deterministic top-$K_{\mathrm  {add}}$ ranker selects the atoms to append. Total trainable parameters: $384 + 657 = 1\,041$. The logits are used only for ranking.}}{17}{figure.caption.21}\protected@file@percent }
\newlabel{fig:head_arch}{{4}{17}{Learned support-refinement head (architecture). Two parallel inputs per candidate $i$: a 7-D self-feature $\mathbf {u}_i$ and a set of 6-D pair features $\{\mathbf {v}_{i,s}\}_{s \in \hat {S}}$ indexed over the current active support $\hat {S}$. The shared pair-encoder ($\mathbb {R}^6 \!\to \! \mathbb {R}^{16} \!\to \! \mathbb {R}^{16}$, 384 parameters) is applied element-wise over $(i, s)$ pairs; order-invariant pooling (concat of channel-wise max and mean over $s \in \hat {S}$) produces a 32-D pair descriptor per candidate, which is concatenated with $\mathbf {u}_i$ to form $\boldsymbol {\phi }_i \in \mathbb {R}^{39}$. The shared scorer ($\mathbb {R}^{39} \!\to \! \mathbb {R}^{16} \!\to \! \mathbb {R}^1$, 657 parameters) emits a scalar logit $s_i$; the deterministic top-$\Kadd $ ranker selects the atoms to append. Total trainable parameters: $384 + 657 = 1\,041$. The logits are used only for ranking}{figure.caption.21}{}}
